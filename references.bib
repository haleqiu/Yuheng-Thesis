@article{Meijer_2018_roadinfra,
doi = {10.1088/1748-9326/aabd42},
url = {https://dx.doi.org/10.1088/1748-9326/aabd42},
year = {2018},
month = {may},
publisher = {IOP Publishing},
volume = {13},
number = {6},
pages = {064006},
author = {Johan R Meijer and Mark A J Huijbregts and Kees C G J Schotten and Aafke M Schipper},
title = {Global patterns of current and future road infrastructure},
journal = {Environmental Research Letters},
abstract = {Georeferenced information on road infrastructure is essential for spatial planning, socio-economic assessments and environmental impact analyses. Yet current global road maps are typically outdated or characterized by spatial bias in coverage. In the Global Roads Inventory Project we gathered, harmonized and integrated nearly 60 geospatial datasets on road infrastructure into a global roads dataset. The resulting dataset covers 222 countries and includes over 21âmillionâkm of roads, which is two to three times the total length in the currently best available country-based global roads datasets. We then related total road length per country to country area, population density, GDP and OECD membership, resulting in a regression model with adjusted R2 of 0.90, and found that that the highest road densities are associated with densely populated and wealthier countries. Applying our regression model to future population densities and GDP estimates from the Shared Socioeconomic Pathway (SSP) scenarios, we obtained a tentative estimate of 3.0â4.7âmillionâkm additional road length for the year 2050. Large increases in road length were projected for developing nations in some of the worldâs last remaining wilderness areas, such as the Amazon, the Congo basin and New Guinea. This highlights the need for accurate spatial road datasets to underpin strategic spatial planning in order to reduce the impacts of roads in remaining pristine ecosystems.}
}

